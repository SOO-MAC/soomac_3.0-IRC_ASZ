#!/usr/bin/env python3

import time

import rclpy
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node

from std_srvs.srv import Trigger

import serial
from serial import SerialException


class NfcPaymentBridge(Node):

    def __init__(self):
        super().__init__("nfc_payment_bridge")

        self.declare_parameter(
            "serial_port",
            "/dev/ttyACM0",
        )

        self.declare_parameter(
            "baudrate",
            115200,
        )

        self.declare_parameter(
            "payment_service",
            "/payment_done",
        )

        self.declare_parameter(
            "reconnect_sec",
            1.0,
        )

        self.serial_port = str(
            self.get_parameter(
                "serial_port"
            ).value
        )

        self.baudrate = int(
            self.get_parameter(
                "baudrate"
            ).value
        )

        self.payment_service = str(
            self.get_parameter(
                "payment_service"
            ).value
        )

        self.reconnect_sec = float(
            self.get_parameter(
                "reconnect_sec"
            ).value
        )

        self.payment_client = self.create_client(
            Trigger,
            self.payment_service,
        )

        self.ser = None
        self.rx_buffer = bytearray()

        self.last_connect_try = 0.0

        self.payment_future = None

        self.timer = self.create_timer(
            0.02,
            self.timer_cb,
        )

        self.get_logger().info(
            "NFC payment bridge ready | "
            f"{self.serial_port}@{self.baudrate} "
            f"-> {self.payment_service}"
        )


    # ========================================================
    # Serial
    # ========================================================

    def try_open_serial(self):

        now = time.monotonic()

        if (
            now - self.last_connect_try
            < self.reconnect_sec
        ):
            return

        self.last_connect_try = now

        try:

            self.ser = serial.Serial(
                port=self.serial_port,
                baudrate=self.baudrate,
                timeout=0,
                write_timeout=0,
            )

            self.rx_buffer.clear()

            self.get_logger().info(
                "ESP32-S3 serial connected | "
                f"{self.serial_port}"
            )

        except (
            SerialException,
            OSError,
        ) as exc:

            self.ser = None

            self.get_logger().warn(
                "ESP32-S3 serial not ready | "
                f"{exc}",
                throttle_duration_sec=5.0,
            )


    def close_serial(self):

        if self.ser is not None:

            try:
                self.ser.close()

            except Exception:
                pass

        self.ser = None

        self.rx_buffer.clear()


    # ========================================================
    # Poll
    # ========================================================

    def timer_cb(self):

        if self.ser is None:

            self.try_open_serial()

            return

        try:

            waiting = int(
                self.ser.in_waiting
            )

            if waiting <= 0:
                return

            data = self.ser.read(
                waiting
            )

            if not data:
                return

            self.rx_buffer.extend(
                data
            )

            if len(
                self.rx_buffer
            ) > 4096:

                self.rx_buffer.clear()

                self.get_logger().warn(
                    "serial buffer overflow -> cleared"
                )

                return


            while b"\n" in self.rx_buffer:

                raw, _, remain = (
                    self.rx_buffer.partition(
                        b"\n"
                    )
                )

                self.rx_buffer = bytearray(
                    remain
                )

                line = raw.decode(
                    "utf-8",
                    errors="replace",
                ).strip()

                self.handle_serial_line(
                    line
                )


        except (
            SerialException,
            OSError,
        ) as exc:

            self.get_logger().warn(
                "ESP32-S3 serial disconnected | "
                f"{exc}"
            )

            self.close_serial()


    # ========================================================
    # ESP32 message
    # ========================================================

    def handle_serial_line(
        self,
        line,
    ):

        if not line:
            return


        # Arduino의 디버그 출력은 전부 무시.
        #
        # 우리가 필요한 것은 이것 하나뿐:
        #
        # NFC_PAYMENT:D397100C
        #
        if not line.startswith(
            "NFC_PAYMENT:"
        ):
            return


        uid = (
            line.split(
                ":",
                1,
            )[1]
            .strip()
            .upper()
        )


        if not uid:

            self.get_logger().warn(
                "empty NFC UID ignored"
            )

            return


        self.get_logger().info(
            "================================"
        )

        self.get_logger().info(
            f"NFC PAYMENT RECEIVED | UID={uid}"
        )


        # ----------------------------------------------------
        # 이미 Arduino에서:
        #
        # 카드 인식
        # -> 삑
        # -> 5초 delay
        # -> NFC_PAYMENT
        #
        # 순서로 처리했으므로
        # ROS에서는 추가 delay 절대 없음.
        # ----------------------------------------------------


        if (
            self.payment_future is not None
            and not self.payment_future.done()
        ):

            self.get_logger().warn(
                "previous payment_done request "
                "still pending -> ignored"
            )

            return


        if not self.payment_client.service_is_ready():

            self.get_logger().error(
                "/payment_done service not ready"
            )

            return


        request = Trigger.Request()

        self.payment_future = (
            self.payment_client.call_async(
                request
            )
        )

        self.payment_future.add_done_callback(
            lambda future, card_uid=uid:
            self.payment_response_cb(
                future,
                card_uid,
            )
        )


    # ========================================================
    # Main response
    # ========================================================

    def payment_response_cb(
        self,
        future,
        uid,
    ):

        try:

            response = future.result()


            if (
                response is not None
                and response.success
            ):

                self.get_logger().info(
                    "PAYMENT ACCEPTED BY MAIN | "
                    f"UID={uid}"
                )

                self.get_logger().info(
                    "Main will continue to "
                    "arm/deliver"
                )


            else:

                message = ""

                if response is not None:
                    message = response.message

                self.get_logger().warn(
                    "PAYMENT NOT ACCEPTED BY MAIN | "
                    f"UID={uid} | "
                    f"{message}"
                )


        except Exception as exc:

            self.get_logger().error(
                "payment_done service call failed | "
                f"{exc!r}"
            )


        finally:

            self.payment_future = None


    def destroy_node(self):

        self.close_serial()

        super().destroy_node()


def main(args=None):

    rclpy.init(
        args=args
    )

    node = NfcPaymentBridge()

    try:

        rclpy.spin(
            node
        )

    except (
        KeyboardInterrupt,
        ExternalShutdownException,
    ):
        pass

    finally:

        node.destroy_node()

        rclpy.try_shutdown()


if __name__ == "__main__":

    main()
