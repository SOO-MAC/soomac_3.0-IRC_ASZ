<?xml version="1.0"?>
<package format="3">
  <name>drive_thru_manager</name>
  <version>0.0.1</version>
  <description>Drive-through FIFO main coordinator and arm-control bridge.</description>

  <maintainer email="user@example.com">SOOMAC</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>soomac_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>control_config</exec_depend>
  <exec_depend>driver_pose</exec_depend>
  <exec_depend>mission_1</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
</package>
